{
	"name": "extension",
	"displayName": "Tabot",
	"description": "Private, local browser activity timeline. Thinking across tabs.",
	"version": "0.2.2",
	"private": true,
	"scripts": {
		"check:ingest": "node --import ../../packages/shared/resolve-hook.mjs ingestion/ingest.check.mts",
		"check:storageOwner": "node --experimental-test-module-mocks --import ../../packages/shared/resolve-hook.mjs storage/owner.check.mts && node --import ../../packages/shared/resolve-hook.mjs storage/client.check.mts",
		"check:dashboardSender": "node --import ../../packages/shared/resolve-hook.mjs dashboard/sender.check.mts",
		"check:pageCaptureConsent": "node --import ../../packages/shared/resolve-hook.mjs capture/consent.check.mts",
		"check:pageCapture": "node --import ../../packages/shared/resolve-hook.mjs ingestion/page-capture.check.mts",
		"check:popup": "node --import ../../packages/shared/resolve-hook.mjs popup/model.check.mts",
		"check:metricsRelay": "node --experimental-test-module-mocks --import ../../packages/shared/resolve-hook.mjs relay/relay-metrics.check.mts",
		"check:foreground": "node --import ../../packages/shared/resolve-hook.mjs background/foreground.check.mts",
		"check": "pnpm check:ingest && pnpm check:storageOwner && pnpm check:dashboardSender && pnpm check:pageCaptureConsent && pnpm check:pageCapture && pnpm check:popup && pnpm check:metricsRelay && pnpm check:foreground",
		"predev": "tailwindcss -i ./popup.css -o ./popup.tailwind.css",
		"dev": "tailwindcss -i ./popup.css -o ./popup.tailwind.css --watch=always & POST_BUILD_SCRIPT=./scripts/copy-taladb-wasm.cjs plasmo dev",
		"dev:preview": "PLASMO_PUBLIC_NOTIFICATION_PREVIEW=1 pnpm dev",
		"prebuild": "tailwindcss -i ./popup.css -o ./popup.tailwind.css --minify",
		"build": "POST_BUILD_SCRIPT=./scripts/copy-taladb-wasm.cjs plasmo build",
		"package": "plasmo package"
	},
	"dependencies": {
		"@lobehub/icons": "^5.16.0",
		"@tabot/shared": "workspace:*",
		"@taladb/web": "0.12.1",
		"@tanstack/pacer": "^0.22.0",
		"lucide-react": "0.562.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"taladb": "0.12.1"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/chrome": "^0.0.268",
		"@types/node": "^22.20.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.0"
	},
	"manifest": {
		"version": "0.2.2",
		"cross_origin_opener_policy": {
			"value": "same-origin"
		},
		"cross_origin_embedder_policy": {
			"value": "credentialless"
		},
		"content_security_policy": {
			"extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost; object-src 'self'; worker-src 'self'"
		},
		"permissions": [
			"offscreen",
			"storage",
			"tabs",
			"webNavigation",
			"windows",
			"idle",
			"alarms"
		],
		"host_permissions": [
			"<all_urls>"
		],
		"externally_connectable": {
			"matches": [
				"http://localhost/*",
				"https://shanvit7.github.io/*",
				"https://tabot-mcp.shanvit7.workers.dev/*",
				"https://tabot-mcp-dev.shanvit7.workers.dev/*"
			]
		}
	}
}
