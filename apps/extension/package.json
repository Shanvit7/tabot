{
	"name": "extension",
	"displayName": "Tabot",
	"description": "Private, local browser activity timeline. Thinking across tabs.",
	"version": "0.1.3",
	"private": true,
	"scripts": {
		"check:popup": "node --import ../../packages/shared/resolve-hook.mjs popup-model.check.mts",
		"check:metricsRelay": "node --experimental-test-module-mocks --import ../../packages/shared/resolve-hook.mjs relay-metrics.check.mts",
		"check:foreground": "node --import ../../packages/shared/resolve-hook.mjs foreground.check.mts",
		"predev": "tailwindcss -i ./popup.css -o ./popup.tailwind.css",
		"dev": "tailwindcss -i ./popup.css -o ./popup.tailwind.css --watch=always & plasmo dev",
		"prebuild": "tailwindcss -i ./popup.css -o ./popup.tailwind.css --minify",
		"build": "plasmo build",
		"package": "plasmo package"
	},
	"dependencies": {
		"@lobehub/icons": "^5.16.0",
		"@tabot/shared": "workspace:*",
		"@tanstack/pacer": "^0.22.0",
		"lucide-react": "0.562.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/chrome": "^0.0.268",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.0"
	},
	"manifest": {
		"permissions": [
			"storage",
			"tabs",
			"webNavigation",
			"windows",
			"idle",
			"alarms",
			"notifications"
		],
		"host_permissions": [
			"<all_urls>"
		],
		"externally_connectable": {
			"matches": [
				"http://localhost/*",
				"https://shanvit7.github.io/*",
				"https://tabot-mcp.shanvit7.workers.dev/*",
				"https://tabot-mcp-dev.shanvit7.workers.dev/*"
			]
		}
	}
}
