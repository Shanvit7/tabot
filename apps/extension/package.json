{
	"name": "extension",
	"displayName": "Tabot",
	"description": "Private, local browser activity timeline. Thinking across tabs.",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package"
	},
	"dependencies": {
		"@tabot/shared": "workspace:*",
		"@tanstack/pacer": "^0.22.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.268",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"typescript": "^5.7.0"
	},
	"manifest": {
		"permissions": [
			"storage",
			"tabs",
			"webNavigation"
		],
		"host_permissions": [
			"<all_urls>"
		],
		"externally_connectable": {
			"matches": [
				"http://localhost:3000/*",
				"https://shanvit7.github.io/*"
			]
		}
	}
}
