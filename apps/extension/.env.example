# Copy to .env.development for local work.
PLASMO_PUBLIC_HOME_URL=http://localhost:3000/home
# PostHog analytics are opt-in locally; production workflows enable them.
# PLASMO_PUBLIC_POSTHOG_ENABLED=false
# PLASMO_PUBLIC_POSTHOG_KEY=
# PostHog Cloud host only; unsupported hosts fall back to US Cloud endpoint.
# PLASMO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build release identifier; set to the Git commit SHA in production.
# PLASMO_PUBLIC_POSTHOG_RELEASE=
# pnpm dev deploys local MCP edits to the separate dev Worker at this stable URL.
PLASMO_PUBLIC_MCP_RELAY_URL=https://tabot-mcp-dev.shanvit7.workers.dev
