{
	"$schema": "https://react.doctor/schema/config.json",
	"rules": {
		"react-doctor/use-lazy-motion": "warn",
		"react-doctor/no-array-index-as-key": "warn",
		"react-doctor/no-multi-comp": "warn"
	},
	"ignore": {
		"files": [".output/**"],
		"overrides": [
			{
				"files": [
					"src/components/landing/hero.tsx",
					"src/components/landing/header.tsx"
				],
				"rules": ["react-doctor/anchor-target-exists"]
			},
			{
				"files": [
					"src/components/landing/privacy-first.tsx",
					"src/components/ui/work-panels.tsx",
					"src/lib/work-charts.tsx",
					"src/lib/context-graph-panels.tsx"
				],
				"rules": ["react-doctor/no-multi-comp"]
			},
			{
				"files": [
					"src/components/landing/hero.tsx",
					"src/components/landing/privacy-first.tsx"
				],
				"rules": ["react-doctor/use-lazy-motion"]
			},
			{
				"files": [
					"src/components/home-page.tsx",
					"src/components/landing/browser-context-film.tsx"
				],
				"rules": ["react-doctor/no-giant-component"]
			},
			{
				"files": ["src/components/ui/button.tsx", "src/lib/work-charts.tsx"],
				"rules": ["react-doctor/only-export-components"]
			},
			{
				"files": [
					"src/components/ui/command.tsx",
					"src/components/ui/popover.tsx"
				],
				"rules": ["react-doctor/no-multi-comp"]
			}
		]
	}
}
