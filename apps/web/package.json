		"@remotion/player": "^4.0.536",
		"@tabot/shared": "workspace:*",
		"@tanstack/pacer": "^0.22.0",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/react-virtual": "^3.14.26",
		"@yusufceng1z/ding-react": "^0.0.4",
		"ascii.rest": "^0.4.0",
		"boneyard-js": "^1.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "0.475.0",
		"motion": "^12.43.0",
		"posthog-js": "^1.449.2",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-call": "^2.0.2",
