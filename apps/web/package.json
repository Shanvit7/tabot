{
	"name": "web",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"dev": "rsbuild dev",
		"build": "rsbuild build && node scripts/generate-seo-files.mjs && tsc --noEmit",
		"preview": "rsbuild preview",
		"check": "pnpm check:homeSearchState && pnpm check:searchResults && pnpm check:notFoundArt && pnpm check:ambient && pnpm check:notesDemo && pnpm check:pairedSearchDemo && pnpm check:extensionConnection",
		"check:ambient": "node src/checks/ambient.check.mjs",
		"check:automationFigure": "node src/checks/automation-figure.check.mjs",
		"check:extensionConnection": "node src/checks/extension-connection.check.mjs",
		"check:notesDemo": "node src/checks/notes-demo.check.mjs",
		"check:pairedSearchDemo": "node src/checks/paired-search-demo.check.mjs",
		"check:searchResults": "node src/checks/result-section.check.mjs",
		"check:notFoundArt": "node src/checks/art.check.mjs",
		"check:webVitals": "node src/checks/landing-web-vitals.check.mjs",
		"check:privacyFlow": "node scripts/check-privacy-flow.mjs",
		"check:tutorial": "node --experimental-strip-types src/checks/chatgpt-tutorial.check.mjs",
		"check:homeSearchState": "node src/checks/state.check.mjs",
		"check:heroAnnotation": "node src/checks/hero-annotation.check.mjs",
		"art:build:notFound": "node scripts/build-not-found-art.mjs",
		"art:build:profileCheck": "node scripts/build-profile-check-art.mjs",
		"doctor": "react-doctor",
		"start": "rsbuild preview"
	},
	"dependencies": {
		"@animate-ui/react": "^2.4.1",
