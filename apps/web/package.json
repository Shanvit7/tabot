{
	"name": "web",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"dev": "rsbuild dev",
		"build": "rsbuild build && node scripts/generate-seo-files.mjs && tsc --noEmit",
		"preview": "rsbuild preview",
		"check": "pnpm check:homeSearchState && pnpm check:searchResults && pnpm check:notFoundArt",
		"check:searchResults": "node src/components/features/home/search/result-section.check.mjs",
		"check:notFoundArt": "node src/components/errors/not-found/art.check.mjs",
		"check:privacyFlow": "node scripts/check-privacy-flow.mjs",
		"check:tutorial": "node --experimental-strip-types src/checks/chatgpt-tutorial.check.mjs",
		"check:homeSearchState": "node src/components/features/home/search/state.check.mjs",
		"art:build:notFound": "node scripts/build-not-found-art.mjs",
		"art:build:profileCheck": "node scripts/build-profile-check-art.mjs",
		"doctor": "react-doctor",
		"start": "rsbuild preview"
	},
	"dependencies": {
		"@animate-ui/react": "^2.4.1",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@lobehub/icons": "^5.23.1",
		"@remotion/player": "^4.0.536",
		"@tabot/shared": "workspace:*",
		"@tanstack/pacer": "^0.22.0",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/react-virtual": "^3.14.26",
		"@yusufceng1z/ding-react": "^0.0.4",
		"boneyard-js": "^1.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "0.475.0",
		"motion": "^12.43.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-call": "^2.0.2",
		"react-dom": "^19.3.1",
		"remotion": "^4.0.536",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@rsbuild/core": "^2.2.14",
		"@rsbuild/plugin-react": "^2.1.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"react-doctor": "^0.9.18",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.4"
	}
}
