{
	"$schema": "https://ui.shadcn.com/schema.json",
	"style": "radix-nova",
	"rsc": false,
	"tsx": true,
	"tailwind": {
		"config": "",
		"css": "src/styles/globals.css",
		"baseColor": "neutral",
		"cssVariables": true,
		"prefix": ""
	},
	"iconLibrary": "lucide",
	"rtl": false,
	"aliases": {
		"components": "~/components",
		"utils": "~/lib/utils",
		"ui": "~/components/ui",
		"lib": "~/lib",
		"hooks": "~/hooks"
	},
	"menuColor": "default",
	"menuAccent": "subtle",
	"registries": {
		"@shadcn-space": "https://shadcnspace.com/r/{name}.json",
		"@animate-ui": "https://animate-ui.com/r/{name}.json",
		"@ding": "https://ding.yusufcengiz.dev/r/{name}.json"
	}
}
