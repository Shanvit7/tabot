# Chrome Web Store extension ID. Set this in GitHub Actions as TABOT_EXTENSION_ID.
VITE_TABOT_EXTENSION_ID=

# Chrome Web Store listing URL. Set after first publication.
VITE_CHROME_WEB_STORE_URL=

# Umami Cloud — sign up free at cloud.umami.is, add your domain, copy the Website ID.
# To self-host later: change VITE_UMAMI_HOST to your own instance. No code changes needed.
# VITE_UMAMI_HOST=https://cloud.umami.is
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Canonical site origin for OG / canonical URLs (no trailing slash).
# Falls back to https://shanvit7.github.io/tabot when unset.
# VITE_SITE_URL=https://tabot.example.com
