# PostHog analytics are opt-in locally; production workflows enable them.
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Build release identifier; set to the Git commit SHA in production.
# VITE_POSTHOG_RELEASE=

# Chrome Web Store extension ID. Set this in GitHub Actions as TABOT_EXTENSION_ID.
VITE_TABOT_EXTENSION_ID=

# Chrome Web Store listing URL. Set after first publication.
VITE_CHROME_WEB_STORE_URL=

# Canonical site URL for OG / canonical URLs (no trailing slash).
VITE_SITE_URL=https://shanvit7.github.io/tabot
