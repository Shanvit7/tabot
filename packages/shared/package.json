{
	"name": "@tabot/shared",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check:sessions": "node src/sessions.check.ts",
		"check:contexts": "node --import ./resolve-hook.mjs src/contexts.check.ts",
		"check:memories": "node --import ./resolve-hook.mjs src/memories.check.ts",
		"check:retrieval": "node --import ./resolve-hook.mjs src/retrieval.check.ts",
		"check:liveContext": "node --import ./resolve-hook.mjs src/live-context.check.ts",
		"check:meaningfulEvents": "node --import ./resolve-hook.mjs src/meaningful-events.check.ts",
		"check:pipeline": "node --import ./resolve-hook.mjs src/pipeline.check.ts",
		"check:activityGraph": "node --import ./resolve-hook.mjs src/activity-graph.check.ts",
		"check:v5regression": "node --import ./resolve-hook.mjs src/v5regression.check.ts"
	},
	"dependencies": {
		"dexie": "^4.4.5",
		"fastest-levenshtein": "^1.0.16",
		"graphology": "^0.26.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.1"
	}
}
