{
	"name": "tabot",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "husky",
		"test": "biome check .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"knip": "knip",
		"doctor": "pnpm --filter web doctor",
		"doctor:staged": "pnpm --filter web exec react-doctor --staged --blocking error",
		"dev": "pnpm -r --if-present --parallel dev",
		"dev:extension": "pnpm --filter extension dev",
		"dev:web": "pnpm --filter web dev"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"destr": "2.0.5",
		"husky": "^9.1.7",
		"knip": "^6.32.3",
		"lint-staged": "^17.3.0",
		"plasmo": "^0.90.5"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
